<aside class="navbar-enterprise sidebar-layout <%= company %>">
    <a class="sidebar-brand" href="/">
        <img src="/images/mascot.png" alt="Maskot Monitoring QC" class="navbar-logo">
        <span>
            <span class="brand-title">Monitoring QC IT Support</span>
            <span class="brand-subtitle">Pusat Gadai Indonesia</span>
        </span>
    </a>

    <button class="navbar-toggler sidebar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarQC" aria-controls="navbarQC" aria-label="Buka menu">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarQC">
        <div class="sidebar-section-label">Menu Utama</div>
        <nav class="navbar-nav sidebar-nav">
            <a href="/" class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %>">
                <i class="bi bi-house-fill"></i><span>Dashboard</span>
            </a>
            <a href="/inventaris" class="nav-link <%= currentPage === 'inventaris' ? 'active' : '' %>">
                <i class="bi bi-list-ul"></i><span>Inventaris</span>
            </a>
            <a href="/batch" class="nav-link <%= currentPage === 'batch' ? 'active' : '' %>">
                <i class="bi <%= currentBatch ? 'bi-upload' : 'bi-plus-circle' %>"></i>
                <span><%= currentBatch ? 'Import Tambahan' : 'Import Batch Baru' %></span>
            </a>
            <a href="/batch/history" class="nav-link <%= currentPage === 'history' ? 'active' : '' %>">
                <i class="bi bi-clock-history"></i><span>Riwayat Batch</span>
            </a>
        </nav>

        <div class="sidebar-card">
            <div class="sidebar-card-title">Pilih Perusahaan</div>
            <form action="/company" method="POST" class="company-switcher">
                <input type="hidden" name="company" value="PGI">
                <button type="submit" class="company-option <%= company === 'PGI' ? 'active' : '' %>">
                    <span>PGI - Pusat Gadai</span>
                    <i class="bi <%= company === 'PGI' ? 'bi-check-lg' : 'bi-arrow-right' %>"></i>
                </button>
            </form>
            <form action="/company" method="POST" class="company-switcher">
                <input type="hidden" name="company" value="PEI">
                <button type="submit" class="company-option <%= company === 'PEI' ? 'active' : '' %>">
                    <span>PEI - Pusat Emas</span>
                    <i class="bi <%= company === 'PEI' ? 'bi-check-lg' : 'bi-arrow-right' %>"></i>
                </button>
            </form>
        </div>

    </div>
</aside>
